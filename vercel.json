{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security",  "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy",
          "value": "default-src 'self' https: 'unsafe-inline' 'unsafe-eval' data: blob:; img-src * data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://formsubmit.co" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",  "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                                               "destination": "/index.html" },
    { "source": "/admin",                                          "destination": "/admin.html" },
    { "source": "/services/civil-engineering",                     "destination": "/service-civil-engineering.html" },
    { "source": "/services/construction-management",               "destination": "/service-construction-management.html" },
    { "source": "/services/infrastructure-development",            "destination": "/service-infrastructure-development.html" },
    { "source": "/services/project-consulting",                    "destination": "/service-project-consulting.html" },
    { "source": "/services/oil-gas-facilities",                    "destination": "/service-oil-gas-facilities.html" },
    { "source": "/services/procurement-services",                  "destination": "/service-procurement-services.html" },
    { "source": "/industries/oil-gas",                             "destination": "/industry-oil-gas.html" },
    { "source": "/industries/public-infrastructure",               "destination": "/industry-public-infrastructure.html" },
    { "source": "/industries/commercial-real-estate",              "destination": "/industry-commercial-real-estate.html" },
    { "source": "/industries/industrial-manufacturing",            "destination": "/industry-industrial-manufacturing.html" },
    { "source": "/industries/power-energy",                        "destination": "/industry-power-energy.html" },
    { "source": "/industries/hospitality-tourism",                 "destination": "/industry-hospitality-tourism.html" },
    { "source": "/industries/agriculture-agro-processing",         "destination": "/industry-agriculture-agro-processing.html" },
    { "source": "/industries/defence-security",                    "destination": "/industry-defence-security.html" }
  ],
  "redirects": [
    { "source": "/home",       "destination": "/",          "permanent": true },
    { "source": "/contact",    "destination": "/#contact",  "permanent": false },
    { "source": "/careers",    "destination": "/#careers",  "permanent": false },
    { "source": "/services",   "destination": "/#services", "permanent": false },
    { "source": "/projects",   "destination": "/#projects", "permanent": false },
    { "source": "/industries", "destination": "/#industries","permanent": false }
  ]
}
